>\n                                <p style={{ fontSize: '0.85rem', color: '#94a3b8' }}>A UNESCO World Heritage Site with historical ruins.</p>\n                            </div>\n                            <div className={styles.attractionItem}>\n                                <h5>Statue of Unity</h5>\n                                <p style={{ fontSize: '0.85rem', color: '#94a3b8' }}>The world&apos;s tallest statue, a monumental tribute.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div className={styles.sliderHeader}>\n                    <h2 className={styles.sectionTitle} style={{ justifyContent: 'center' }}>\n                        <Camera size={32} /> Local Highlights\n                    </h2>\n                    <TouristSlider aspectRatio=\"21 / 9\" maxWidth=\"1200px\" />\n                </div>\n\n            </div>\n        </section>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/amitsrivastava/Desktop/iapcgccon2026/iapsmgc2026/components/sections/Venue.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/amitsrivastava/Desktop/iapcgccon2026/iapsmgc2026/components/ui/Modal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/amitsrivastava/Desktop/iapcgccon2026/iapsmgc2026/components/ui/ScrollReveal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/amitsrivastava/Desktop/iapcgccon2026/iapsmgc2026/data/conference.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningC