 to "},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[11517,11562],"text":"Under General access, change \"Restricted&ldquo; to "},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[11517,11562],"text":"Under General access, change \"Restricted&#34; to "},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[11517,11562],"text":"Under General access, change \"Restricted&rdquo; to "},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":234,"column":106,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[11570,11592],"text":"&quot;Anyone with the link\""},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[11570,11592],"text":"&ldquo;Anyone with the link\""},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[11570,11592],"text":"&#34;Anyone with the link\""},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[11570,11592],"text":"&rdquo;Anyone with the link\""},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":234,"column":127,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[11570,11592],"text":"\"Anyone with the link&quot;"},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[11570,11592],"text":"\"Anyone with the link&ldquo;"},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[11570,11592],"text":"\"Anyone with the link&#34;"},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[11570,11592],"text":"\"Anyone with the link&rdquo;"},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":235,"column":67,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[11674,11685],"text":"&quot;Copy link\""},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[11674,11685],"text":"&ldquo;Copy link\""},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[11674,11685],"text":"&#34;Copy link\""},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[11674,11685],"text":"&rdquo;Copy link\""},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":235,"column":77,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[11674,11685],"text":"\"Copy link&quot;"},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[11674,11685],"text":"\"Copy link&ldquo;"},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[11674,11685],"text":"\"Copy link&#34;"},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[11674,11685],"text":"\"Copy link&rdquo;"},"desc":"Replace with `&rdquo;`."}]}],"suppressedMessages":[],"errorCount":13,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport { useState } from 'react';\nimport styles from './SubmissionGuidelines.module.css';\nimport heroStyles from './Hero.module.css';\nimport ScrollReveal from '@/components/ui/ScrollReveal';\nimport { X, CheckCircle2 } from 'lucide-react';\n\nconst guidelinesData = [\n    {\n        number: \"01\",\n        title: \"Prepare Abstract\",\n        text: \"Submit an abstract of 250-300 words with 5-6 keywords. Follow APA/MLA 9th Edition style.\"\n    },\n    {\n        number: \"02\",\n        title: \"Submit for Review\",\n        text: \"Send your abstract by clicking the below button. All submissions will undergo double-blind peer review.\"\n    },\n    {\n        number: \"03\",\n        title: \"Wait for Acceptance\",\n        text: \"Notifications of acceptance will be sent via email by the specified date.\"\n    },\n    {\n        number: \"04\",\n        title: \"Full Paper Submission\",\n        text: \"Upon acceptance, submit the full paper (min 7000 words) adhering to formatting guidelines.\"\n    },\n    {\n        number: \"05\",\n        title: \"Registration\",\n        text: \"Complete the registration process first to ensure your participation.\"\n    }\n];\n\nexport function SubmissionGuidelines() {\n    const [isModalOpen, setIsModalOpen] = useState(false);\n    const [isSubmitting, setIsSubmitting] = useState(false);\n    const [submissionSuccess, setSubmissionSuccess] = useState(false);\n\n    const [formData, setFormData] = useState({\n        name: '',\n        email: '',\n        documentLink: '',\n    });\n\n    const handleFormSubmit = async (e: React.FormEvent) => {\n        e.preventDefault();\n        setIsSubmitting(true);\n\n        try {\n            const { name: fullName, email, documentLink } = formData;\n\n            const res = await fetch(\"https://script.google.com/macros/s/AKfycbymq8pRHk--R9ItUFGBkmwFrCnfuqzUr4BojT4wOG8l5edYgFrp1D_1fDHTAVe8eyh1kg/exec\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"text/plain;charset=utf-8\",\n                },\n                body: JSON.stringify({\n                    type: \"ABSTRACT\",\n                    fullName,\n                    email,\n                    documentLink\n                }),\n            });\n            const text = await res.text();\n\n            if (text.startsWith(\"<!DOCTYPE\") || text.startsWith(\"<html\")) {\n                if (res.ok) setSubmissionSuccess(true);\n                else throw new Error(\"Server returned an HTML error page.\");\n            } else {\n                let result;\n                try {\n                    result = JSON.parse(text);\n                } catch {\n                    if (res.ok) setSubmissionSuccess(true);\n                    else throw new Error(\"Invalid JSON response from server.\");\n                }\n\n                if (result && (result.status === \"success\" || result.success === true)) {\n                    setSubmissionSuccess(true);\n                } else if (result) {\n                    throw new Error(result.message || result.error || \"Submission failed\");\n                }\n            }\n\n            if (submissionSuccess || res.ok) {\n                setSubmissionSuccess(true);\n                setTimeout(() => {\n                    setIsModalOpen(false);\n                    setSubmissionSuccess(false);\n                    setFormData({ name: \"\", email: \"\", documentLink: \"\" });\n                }, 2000);\n            }\n        } catch (error: any) {\n            console.error(\"Submission error:\", error);\n            alert(\"Submission failed: \" + (error.message || \"Unexpected response from server.\"));\n        } finally {\n            setIsSubmitting(false);\n        }\n    };\n\n    return (\n        <section className={`section ${styles.guidelines}`} id=\"submit\">\n            <div className=\"container\">\n                <ScrollReveal>\n                    <div className={styles.header}>\n                        <span className={styles.subtitle}>AUTHOR INSTRUCTIONS</span>\n                        <h2 className={styles.title}>Submission Guidelines</h2>\n                        <p className={styles.description}>\n                            Please ensure your research is original and has not been published elsewhere. Plagiarism checks will be conducted strictly.\n                        </p>\n                    </div>\n                </ScrollReveal>\n\n                <div className={styles.list}>\n                    {guidelinesData.map((item, index) => (\n                        <ScrollReveal\n                            key={index}\n                            animation=\"fade-up\"\n                            delay={(index * 100) as 0 | 100 | 200 | 300 | 400 | 500}\n                        >\n                            <div className={styles.card}>\n                                <div className={styles.number}>\n                                    {item.number}\n                                </div>\n                                <div className={styles.content}>\n                                    <h3 className={styles.stepTitle}>{item.title}</h3>\n                                    <p className={styles.stepText}>{item.text}</p>\n\n                                    {/* Action button added to step 02 */}\n                                    {item.number === \"02\" && (\n                                        <button\n                                            onClick={() => setIsModalOpen(true)}\n                                            style={{\n                                                marginTop: '1rem',\n                                                padding: '0.6rem 1.25rem',\n                                                backgroundColor: '#facc15',\n                                                color: '#0f172a',\n                                                border: 'none',\n                                                borderRadius: '6px',\n                                                fontWeight: 700,\n                                                fontSize: '0.9rem',\n                                                cursor: 'pointer',\n                                                boxShadow: '0 4px 12px rgba(250, 204, 21, 0.2)',\n                                                transition: 'transform 0.2s ease, box-shadow 0.2s ease'\n                                            }}\n                                            onMouseOver={(e) => e.currentTarget.style.transform = 'translateY(-2px)'}\n                                            onMouseOut={(e) => e.currentTarget.style.transform = 'translateY(0)'}\n                                        >\n                                            Submit Abstract\n                                        </button>\n                                    )}\n                                </div>\n                            </div>\n                        </ScrollReveal>\n                    ))}\n                </div>\n            </div>\n\n            {/* Submission Modal matching the one in Hero */}\n            {isModalOpen && (\n                <div\n                    className={heroStyles.modalOverlay}\n                    onClick={() => setIsModalOpen(false)}\n                >\n                    <div\n                        className={heroStyles.modalContent}\n                        onClick={(e) => e.stopPropagation()}\n                    >\n                        <button\n                            className={heroStyles.closeButton}\n                            onClick={() => setIsModalOpen(false)}\n                        >\n                            <X size={24} />\n                        </button>\n\n                        {submissionSuccess ? (\n                            <div className={heroStyles.successState}>\n                                <div className={heroStyles.successIconWrapper}>\n                                    <CheckCircle2 size={64} className={heroStyles.successCheck} />\n                                </div>\n                                <h2 className={heroStyles.successTitle}>Success!</h2>\n                                <p className={heroStyles.successSubtitle}>\n                                    Your document has been successfully submitted.\n                                </p>\n                            </div>\n                        ) : (\n                            <>\n                                <h2 className={heroStyles.modalTitle}>Submit Abstract</h2>\n                                <p className={heroStyles.modalSubtitle}>\n                                    Please fill the details below. Your submission will be recorded securely.\n                                </p>\n\n                                <form onSubmit={handleFormSubmit} className={heroStyles.modalForm}>\n                                    <div className={heroStyles.formGroup}>\n                                        <label htmlFor=\"guidelines_name\">Full Name *</label>\n                                        <input\n                                            type=\"text\"\n                                            id=\"guidelines_name\"\n                                            required\n                                            value={formData.name}\n                                            onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                                            placeholder=\"Enter your full name\"\n                                        />\n                                    </div>\n\n                                    <div className={heroStyles.formGroup}>\n                                        <label htmlFor=\"guidelines_email\">Email Address *</label>\n                                        <input\n                                            type=\"email\"\n                                            id=\"guidelines_email\"\n                                            required\n                                            value={formData.email}\n                                            onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                                            placeholder=\"Enter your email\"\n                                        />\n                                    </div>\n\n                                    <div className={heroStyles.formGroup}>\n                                        <div style={{\n                                            backgroundColor: \"rgba(59, 130, 246, 0.1)\",\n                                            borderLeft: \"4px solid #3b82f6\",\n                                            padding: \"1rem\",\n                                            borderRadius: \"0 8px 8px 0\",\n                                            marginBottom: \"1.25rem\"\n                                        }}>\n                                            <h4 style={{ color: \"#60a5fa\", margin: \"0 0 0.5rem 0\", fontSize: \"0.95rem\", fontWeight: 600 }}>How to convert a PDF to a Google Doc Link:</h4>\n                                            <ol style={{ margin: 0, paddingLeft: \"1.2rem\", color: \"#94a3b8\", fontSize: \"0.85rem\", lineHeight: 1.5 }}>\n                                                <li>Upload your PDF file to your <strong>Google Drive</strong>.</li>\n                                                <li>Right-click the uploaded PDF, select <strong>\"Open with\"</strong> &rarr; <strong>\"Google Docs\"</strong>.</li>\n                                                <li>Once open, click the blue <strong>\"Share\"</strong> button (top right).</li>\n                                                <li>Under General access, change \"Restricted\" to <strong>\"Anyone with the link\"</strong>.</li>\n                                                <li>Click <strong>\"Copy link\"</strong> and paste it in the field below.</li>\n                                            </ol>\n                                        </div>\n                                        <label htmlFor=\"guidelines_link\">Document Link *</label>\n                                        <input\n                                            type=\"url\"\n                                            id=\"guidelines_link\"\n                                            required\n                                            value={formData.documentLink}\n                                            onChange={(e) => setFormData({ ...formData, documentLink: e.target.value })}\n                                            placeholder=\"https://docs.google.com/...\"\n                                            style={{\n                                                width: '100%',\n                                                padding: '0.75rem 1rem',\n                                                borderRadius: '8px',\n                                                border: '1px solid rgba(255, 255, 255, 0.1)',\n                                                backgroundColor: 'rgba(15, 23, 42, 0.6)',\n                                                color: 'white',\n                                                fontSize: '1rem',\n                                                outline: 'none',\n                                                transition: 'border-color 0.2s'\n                                            }}\n                                        />\n                                    </div>\n\n                                    <button\n                                        type=\"submit\"\n                                        disabled={isSubmitting}\n                                        className={heroStyles.submitModalBtn}\n                                    >\n                                        {isSubmitting ? \"Submitting...\" : \"Submit to Committee\"}\n                                    </button>\n                                </form>\n                            </>\n                        )}\n                    </div>\n                </div>\n            )}\n        </section>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/amitsrivastava/Desktop/iapcgccon2026/iapsmgc2026/components/sections/Themes.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/amitsrivastava/Desktop/iapcgccon2026/iapsmgc2026/components/sections/Timeline.tsx","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":28,"column":75,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":28,"endColumn":78,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1370,1373],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1370,1373],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/amitsrivastava/Desktop/iapcgccon2026/iapsmgc2026/components/sections/TouristSlider.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/amitsrivastava/Desktop/iapcgccon2026/iapsmgc2026/components/sections/Travel.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Info' is defined but never used.","line":3,"column":52,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":56,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Info"},"fix":{"range":[97,103],"text":""},"desc":"Remove unused variable \"Info\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\nimport { useState } from 'react';\nimport { MapPin, Plane, Train, Car, Hotel, Camera, Info } from 'lucide-react';\nimport TouristSlider from './TouristSlider';\nimport styles from './Travel.module.css';\n\nexport default function Travel() {\n    const [mapSrc, setMapSrc] = useState(\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3690.413233214488!2d73.3613!3d22.2891!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x395fca876ed3a4d3%3A0x6a05e5d36e7616f7!2sParul%20University!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin\");\n\n    return (\n        <section className={styles.travel}>\n            <div className={styles.container}>\n                <div className={styles.header}>\n                    <h1 className={styles.title}>Travel & Accommodation</h1>\n                    <p className={styles.subtitle}>\n                        Plan your trip to Vadodara for IAPSMGC CON 2026. Find information on travel, visas, and local stays.\n                    </p>\n                </div>\n\n                <div className={styles.grid}>\n                    <div className={styles.card}>\n                        <h2 className={styles.sectionTitle}>\n                            <Car size={32} /> How to Reach\n                        </h2>\n                        <div className={styles.reachItem}>\n                            <h4><Plane size={18} /> By Air</h4>\n                            <p>\n                                Vadodara Airport (BDQ) is the nearest airport, connected to major Indian cities.\n                                The university is approximately a 30-minute drive from the airport.\n                            </p>\n                            <button\n                                onClick={() => setMapSrc(\"https://maps.google.com/maps?width=100%25&height=600&hl=en&q=Vadodara+Airport+BDQ+to+Parul+University&t=&z=13&ie=UTF8&iwloc=B&output=embed\")}\n                                className={styles.reachButton}\n                            >\n                                Reach Parul: By Air <MapPin size={16} />\n                            </button>\n                        </div>\n                        <div className={styles.reachItem}>\n                            <h4><Train size={18} /> By Rail</h4>\n                            <p>\n                                Vadodara Junction (BRC) is a major railway station on the Western Railway line,\n                                with excellent connectivity across India.\n                            </p>\n                            <button\n                                onClick={() => setMapSrc(\"https://maps.google.com/maps?width=100%25&height=600&hl=en&q=Vadodara+Junction+BRC+to+Parul+University&t=&z=13&ie=UTF8&iwloc=B&output=embed\")}\n                                className={styles.reachButton}\n                            >\n                                Reach Parul: By Rail <MapPin size={16} />\n                            </button>\n                        </div>\n                        <div className={styles.reachItem}>\n                            <h4><Car size={18} /> By Road</h4>\n                            <p>\n                                Vadodara is connected by National Highway 48 & National Expressway 1.\n                                Taxis and local transport are readily available to reach the university campus.\n                            </p>\n                            <button\n                                onClick={() => setMapSrc(\"https://maps.google.com/maps?width=100%25&height=600&hl=en&q=Parul+University+Vadodara&t=&z=14&ie=UTF8&iwloc=B&output=embed\")}\n                                className={styles.reachButton}\n                            >\n                                Reach Parul: By Road <MapPin size={16} />\n                            </button>\n                        </div>\n                    </div>\n\n                    <div className={styles.mapWrapper}>\n                        <h2 className={styles.sectionTitle}>\n                            <MapPin size={32} /> Conference Venue\n                        </h2>\n                        <iframe\n                            src={mapSrc}\n                            width=\"100%\"\n                            height=\"100%\"\n                            style={{ border: 0 }}\n                            allowFullScreen\n                            loading=\"lazy\"\n                            referrerPolicy=\"no-referrer-when-downgrade\"\n                            className={styles.mapFrame}\n                        ></iframe>\n                    </div>\n                </div>\n\n                <div className={styles.grid}>\n                    <div className={styles.card}>\n                        <h2 className={styles.sectionTitle}>\n                            <Hotel size={32} /> Accommodation\n                        </h2>\n                        <ul className={styles.accommodationList}>\n                            <li className={styles.accommodationItem}>\n                                <span className={styles.hotelName}>University Guest House</span>\n                                <span className={styles.hotelDistance}>On Campus</span>\n                            </li>\n                            <li className={styles.accommodationItem}>\n                                <span className={styles.hotelName}>Vadpadraka Hotel & Resort</span>\n                                <span className={styles.hotelDistance}>2.3 km from venue</span>\n                    